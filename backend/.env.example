# ── platform ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=change-me

# How long to wait for a student service. Free hosting sleeps, so be generous.
STUDENT_SERVICE_TIMEOUT_MS=30000

# ── student services ─────────────────────────────────────────────────────────
# Fill these in as each team hands over their URL. Leave blank until then —
# the adapter returns a clear 503 rather than crashing the platform.

SKILLS_GAP_SERVICE_URL=
SKILLS_GAP_APP_URL=

CAREER_PATH_SERVICE_URL=
CAREER_PATH_APP_URL=

MATCHING_SERVICE_URL=
MATCHING_APP_URL=

CHATBOT_SERVICE_URL=
CHATBOT_APP_URL=

SESSION_VALUE_SERVICE_URL=
SESSION_VALUE_APP_URL=

PRICING_SERVICE_URL=
PRICING_APP_URL=

ANALYTICS_SERVICE_URL=
ANALYTICS_APP_URL=

MICRO_LEARNING_SERVICE_URL=
MICRO_LEARNING_APP_URL=
